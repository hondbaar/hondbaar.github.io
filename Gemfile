source "https://rubygems.org"

# GitHub Pages bouwt de site met deze gem-set (inclusief de juiste Jekyll-versie).
# Lokaal testen: `bundle install` en `bundle exec jekyll serve`.
gem "github-pages", group: :jekyll_plugins

# Tijdzone-data voor Windows/sommige Linux-omgevingen
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
